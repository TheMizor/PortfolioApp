<Window x:Class="PortfolioApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio - Agrégateur de positions" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>

        <!-- Onglet Imports -->
        <TabItem Header="Imports">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnScanFolder" 
                    Content="🔄 Tout importer (dossier fiscalité)" 
                    Padding="10,5" 
                    Margin="0,0,15,0"
                    Background="#D4EDDA"
                    FontWeight="Bold"
                    Click="BtnScanFolder_Click"/>
                    <Button x:Name="BtnImportBitstack" 
                    Content="Importer un CSV Bitstack" 
                    Padding="10,5" 
                    Margin="0,0,5,0"
                    Click="BtnImportBitstack_Click"/>
                    <Button x:Name="BtnImportBoursobank" 
                    Content="Importer un PDF Boursobank" 
                    Padding="10,5"
                    Margin="0,0,5,0"
                    Click="BtnImportBoursobank_Click"/>
                    <Button x:Name="BtnManualEntry" 
                    Content="Saisie manuelle" 
                    Padding="10,5" 
                    Background="#E8F4FD"
                    Click="BtnManualEntry_Click"/>
                    <Button x:Name="BtnTransfer" 
                    Content="Transfert entre comptes" 
                    Padding="10,5" 
                    Margin="5,0,0,0"
                    Background="#FFF8E1"
                    Click="BtnTransfer_Click"/>
                </StackPanel>

                <TextBox x:Name="TxtLog" 
                         Grid.Row="1" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </Grid>
        </TabItem>

        <!-- Onglet Positions -->
        <TabItem Header="Positions" x:Name="TabPositions">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnRefreshPositions" 
                            Content="Rafraîchir" 
                            Padding="10,5"
                            Margin="0,0,10,0"
                            Click="BtnRefreshPositions_Click"/>
                    <CheckBox x:Name="ChkIncludeEmpty" 
                              Content="Inclure positions soldées (qty = 0)" 
                              VerticalAlignment="Center"
                              Click="BtnRefreshPositions_Click"/>
                </StackPanel>

                <DataGrid x:Name="GridPositions" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F5F5F5"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Compte" 
                                            Binding="{Binding AccountName}" 
                                            Width="120"/>
                        <DataGridTextColumn Header="Symbole" 
                                            Binding="{Binding AssetSymbol}" 
                                            Width="160"/>
                        <DataGridTextColumn Header="Type" 
                                            Binding="{Binding AssetType}" 
                                            Width="80"/>
                        <DataGridTextColumn Header="Quantité" 
                                            Binding="{Binding QuantityFormatted}" 
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRU" 
                                            Binding="{Binding AveragePriceFormatted}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Coût total" 
                                            Binding="{Binding TotalCostFormatted}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Frais cumulés" 
                                            Binding="{Binding TotalFeesFormatted}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nb tx" 
                                            Binding="{Binding TransactionCount}" 
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtPositionsSummary" 
                           Grid.Row="2"
                           Margin="0,10,0,0"
                           FontStyle="Italic"
                           Foreground="#555"/>
            </Grid>
        </TabItem>

        <!-- Onglet Transactions -->
        <TabItem Header="Transactions">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnRefreshTransactions" 
                    Content="Rafraîchir" 
                    Padding="10,5"
                    Margin="0,0,10,0"
                    Click="BtnRefreshTransactions_Click"/>
                    <Button x:Name="BtnEditTransaction" 
                    Content="Modifier la sélection" 
                    Padding="10,5"
                    Margin="0,0,5,0"
                    Click="BtnEditTransaction_Click"/>
                    <Button x:Name="BtnDeleteTransaction" 
                    Content="Supprimer la sélection" 
                    Padding="10,5"
                    Background="#FFE0E0"
                    Click="BtnDeleteTransaction_Click"/>
                </StackPanel>

                <DataGrid x:Name="GridTransactions" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F5F5F5"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" 
                                    Binding="{Binding Date, StringFormat=yyyy-MM-dd}" 
                                    Width="100"/>
                        <DataGridTextColumn Header="Compte" 
                                    Binding="{Binding Account.Name}" 
                                    Width="120"/>
                        <DataGridTextColumn Header="Type" 
                                    Binding="{Binding Type}" 
                                    Width="90"/>
                        <DataGridTextColumn Header="Actif" 
                                    Binding="{Binding Asset.Symbol}" 
                                    Width="160"/>
                        <DataGridTextColumn Header="Quantité" 
                                    Binding="{Binding Quantity, StringFormat=N8}" 
                                    Width="120"/>
                        <DataGridTextColumn Header="Prix unit." 
                                    Binding="{Binding UnitPrice, StringFormat=N4}" 
                                    Width="100"/>
                        <DataGridTextColumn Header="Frais" 
                                    Binding="{Binding Fees, StringFormat=N2}" 
                                    Width="70"/>
                        <DataGridTextColumn Header="Source" 
                                    Binding="{Binding SourceFile}" 
                                    Width="200"/>
                        <DataGridTextColumn Header="Note" 
                                    Binding="{Binding RawData}" 
                                    Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtTransactionsSummary" 
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   FontStyle="Italic"
                   Foreground="#555"/>
            </Grid>
        </TabItem>

    </TabControl>
        <!-- Overlay de chargement (caché par défaut) -->
        <Grid x:Name="LoadingOverlay" 
          Background="#80000000" 
          Visibility="Collapsed"
          Panel.ZIndex="1000">
            <Border Background="White" 
                CornerRadius="8"
                Padding="40,30"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MinWidth="300">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" 
                             Height="6" 
                             Width="250"
                             Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtLoadingMessage" 
                           Text="Chargement..." 
                           FontSize="14"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>