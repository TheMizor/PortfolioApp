<Window x:Class="PortfolioApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio - Test Import" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="BtnImportBitstack" 
            Content="Importer un CSV Bitstack" 
            Padding="10,5" 
            Margin="0,0,5,0"
            Click="BtnImportBitstack_Click"/>
            <Button x:Name="BtnImportBoursobank" 
            Content="Importer un PDF Boursobank" 
            Padding="10,5" 
            Click="BtnImportBoursobank_Click"/>
        </StackPanel>

        <TextBox x:Name="TxtLog" 
                 Grid.Row="1" 
                 Margin="10" 
                 IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"/>
    </Grid>
</Window>